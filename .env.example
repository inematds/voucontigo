# Supabase (criar projeto em https://supabase.com e copiar de Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Telegram — criar bot com @BotFather (token só do bot do Vou Contigo)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_CHAT_GESTAO=

# Cron (Vercel envia Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=

# Fuso do processo (na Vercel, definir TZ nas env vars do projeto)
TZ=America/Sao_Paulo

# Site
NEXT_PUBLIC_SITE_URL=https://voucontigo.vercel.app
NEXT_PUBLIC_WHATSAPP_EMPRESA=5551999999999

# --- v2 ---
# WhatsApp — provedor padrão: Evolution API (self-hosted, número comum via QR). Alternativa: meta
WHATSAPP_PROVIDER=evolution
# Evolution API (https://doc.evolution-api.com) — instância criada no manager, webhook apontando p/ /api/whatsapp?token=WHATSAPP_WEBHOOK_TOKEN
EVOLUTION_API_URL=http://evolution:8080
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=voucontigo
# Segredo do webhook de entrada (Evolution não assina; vai na query string ?token=)
WHATSAPP_WEBHOOK_TOKEN=
# Meta Cloud API (só se WHATSAPP_PROVIDER=meta)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# E-mail transacional (Resend — API REST, sem SDK). Vazio = fake em dev/testes
RESEND_API_KEY=
EMAIL_FROM=Vou Contigo <contato@voucontigo.com.br>

# Asaas (sandbox: https://sandbox.asaas.com — produção: https://api.asaas.com/v3)
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
ASAAS_BASE_URL=https://sandbox.asaas.com/api/v3

# Geocodificação do raio de atendimento (vazio = raio "não verificado", nada bloqueia)
GEOCODER_PROVIDER=nominatim
GEOCODING_URL=https://nominatim.openstreetmap.org/search
GEOCODER_EMAIL=
